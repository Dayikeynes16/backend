# ==============================================================================
# Carnicería SaaS — variables de entorno
# ==============================================================================
# Copia este archivo a .env y ajusta lo necesario. Los bloques marcados
# [REQUERIDO] hacen falta para que la aplicación funcione en local; el resto
# tiene valores por defecto razonables y solo se toca si se necesita.
#
# Tras cambiar cualquier valor: `vendor/bin/sail artisan config:clear`
# ==============================================================================

APP_NAME="Carniceria SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_TIMEZONE=America/Mexico_City

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Base de datos [REQUERIDO]
# ------------------------------------------------------------------------------
# El proyecto corre sobre PostgreSQL 18 (contenedor de Sail). Estos valores
# coinciden con compose.yaml; el host `pgsql` es el nombre del servicio Docker.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=carniceria_saas
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Tiempo real — Laravel Reverb [REQUERIDO]
# ------------------------------------------------------------------------------
# Sin este bloque el cajero NO recibe las ventas de la báscula: la cola de
# ventas se queda vacía y no hay ningún error visible que lo explique.
#
# Genera credenciales locales cualesquiera (no son secretas en desarrollo) o
# usa `vendor/bin/sail artisan reverb:install`. El servidor se levanta con
# `vendor/bin/sail artisan reverb:start` y escucha en el puerto 8080.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# El frontend (Echo) lee estas; deben espejear las de arriba.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ------------------------------------------------------------------------------
# Correo
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@carniceria-saas.test"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Almacenamiento
# ------------------------------------------------------------------------------
# "public" en local; Laravel Cloud fija "private" automáticamente.
FILESYSTEM_DISK=public

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Disco PRIVADO para adjuntos de gastos, compras y comprobantes de pago.
# local  → storage/app/private (desarrollo)
# private→ disco privado de Laravel Cloud (producción)
# s3_private → S3/R2 propio; requiere el bloque AWS_PRIVATE_* de abajo
# Ver config/expenses.php para el detalle por entorno.
EXPENSES_DISK=local

# Solo si EXPENSES_DISK=s3_private
AWS_PRIVATE_ACCESS_KEY_ID=
AWS_PRIVATE_SECRET_ACCESS_KEY=
AWS_PRIVATE_DEFAULT_REGION=auto
AWS_PRIVATE_BUCKET=
AWS_PRIVATE_ENDPOINT=
AWS_PRIVATE_URL=
AWS_PRIVATE_USE_PATH_STYLE_ENDPOINT=true

# ------------------------------------------------------------------------------
# OpenAI — asistente conversacional y captura con IA
# ------------------------------------------------------------------------------
# Sin OPENAI_API_KEY: el asistente y los botones "Registrar con IA" devuelven 502.
# El resto de la aplicación funciona con normalidad.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=60
AI_PROVIDER=openai

# Modelos (los defaults del código; descomenta solo para cambiarlos)
# AI_EXPENSES_MODEL=gpt-4o
# AI_ASSISTANT_MODEL=gpt-4o-mini
# AI_ASSISTANT_MODEL_VISION=gpt-4o
# AI_TRANSCRIPTION_MODEL=whisper-1
# AI_TRANSCRIPTION_LANGUAGE=es

# Límites y costo
# AI_ASSISTANT_RATE_USER_HOUR=60
# AI_ASSISTANT_RATE_TENANT_DAY=1000
# AI_ASSISTANT_DEFAULT_BUDGET_CENTS=5000
# AI_ASSISTANT_DRAFT_TTL_HOURS=6
# AI_DRAFT_TTL_HOURS=24
# AI_MAX_AUDIO_BYTES=10485760
# AI_MAX_AUDIO_SECONDS=90
# AI_SCALE_TRANSCRIBE_PER_HOUR=120

# ------------------------------------------------------------------------------
# ElevenLabs — voz de salida del asistente (TTS)
# ------------------------------------------------------------------------------
# Implementado pero DESACTIVADO en la interfaz. Dejar vacío salvo que se retome.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=nTkjq09AuYgsNR8E4sDe
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# ------------------------------------------------------------------------------
# Google Maps — cotización de envío del menú QR
# ------------------------------------------------------------------------------
# Solo hace falta con FEATURE_WEB_ORDERS=true. VITE_GOOGLE_MAPS_KEY la usa el
# frontend; GOOGLE_MATRIX_API_KEY el backend (si se omite, cae a la de Vite).
VITE_GOOGLE_MAPS_KEY=
GOOGLE_MATRIX_API_KEY=

# ------------------------------------------------------------------------------
# Feature flags globales — ver config/features.php
# ------------------------------------------------------------------------------
# Pedidos web / menú QR público. OFF por defecto: con false no se registran ni
# la SPA /menu, ni la API pública, ni la vinculación pedido↔venta.
FEATURE_WEB_ORDERS=false

VITE_APP_NAME="${APP_NAME}"
